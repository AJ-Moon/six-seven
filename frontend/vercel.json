{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.sixseven.pk" }],
      "destination": "https://sixseven.pk/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/orders",
      "destination": "https://six-seven-production-8ce3.up.railway.app/api/orders"
    },
    {
      "source": "/api/orders/",
      "destination": "https://six-seven-production-8ce3.up.railway.app/api/orders/"
    },
    {
      "source": "/api/:path*",
      "destination": "https://six-seven-production-8ce3.up.railway.app/api/:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "https://six-seven-production-8ce3.up.railway.app/static/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
